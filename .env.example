# Copy to .env.local and fill in. Names only: never commit real values.
# Production values live in Vercel. Use Stripe TEST keys locally.

# Sanity
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
NEXT_PUBLIC_SANITY_API_VERSION=
SANITY_API_TOKEN=
SANITY_WEBHOOK_SECRET=
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_SANITY_DATASET=

# Stripe (test keys locally)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# Local: the whsec_ printed by `stripe listen`. Prod: the dashboard endpoint secret.
STRIPE_WEBHOOK_SECRET=

# Resend
RESEND_API_KEY=

# BotPoison (server-side verification of form solutions)
BOTPOISON_SECRET_KEY=

# Supabase: leads, conversations and payments (never NEXT_PUBLIC_ for the secret)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Cron auth for /api/keep-alive and /api/reset-meters
CRON_SECRET=

# IndexNow
INDEXNOW_KEY=

# WhatsApp (Kapso transport)
KAPSO_API_KEY=
KAPSO_WEBHOOK_SECRET=
WHATSAPP_WEBHOOK_TOKEN=
KAPSO_API_BASE=
WHATSAPP_VERIFY_TOKEN=
# Per-tenant overrides (Grand Bay of the Sea)
KAPSO_API_KEY_GRANDBAY=
KAPSO_PROJECT_WEBHOOK_SECRET=
KAPSO_PROJECT_WEBHOOK_SECRET_GRANDBAY=

# Claude: powers the WhatsApp agent
ANTHROPIC_API_KEY=
ANTHROPIC_API_KEY_CLIENT=
